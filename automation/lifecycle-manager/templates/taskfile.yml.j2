# ============================================================================
# OpenSpace Environment Taskfile — {{ env_name }}
#
# This is the entrypoint Taskfile for this environment.
# It includes the automation Taskfile and injects env-specific variables.
#
# Add custom per-environment tasks below the includes block.
# ============================================================================
version: '3'

vars:
  OPENSPACE_DIR: "{{ openspace_directory }}"
  ONBOARDER_VERSION: "{{ onboarder.tag }}"

includes:
  Lifecycle:
    taskfile: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/lifecycle-manager/Taskfile.lcm.yml"
    dir: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/lifecycle-manager"

  Reference:
    taskfile: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/reference_architecture/Taskfile.ref_arch.yml"
    dir: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/reference_architecture"

  Clusters:
    taskfile: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/clusters/Taskfile.clusters.yml"
    dir: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/clusters"

  Onboarder:
    taskfile: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/onboarder/Taskfile.onboarder.yml"
    dir: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/onboarder"

  Servers:
    taskfile: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/servers/Taskfile.servers.yml"
    dir: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/servers"

  Virtualization:
    taskfile: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/virtualization/Taskfile.virtualization.yml"
    dir: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/automation/virtualization"

  Custom:
    taskfile: "{{ '{{' }}.OPENSPACE_DIR{{ '}}' }}/env/{{ env_name }}/custom/Taskfile.yml"
    optional: true