# ============================================================================
# OpenSpace Environment Taskfile — {{ env_name }}
#
# This is the entrypoint Taskfile for this environment.
# It includes the automation Taskfile and injects env-specific variables.
#
# Add custom per-environment tasks below the includes block.
# ============================================================================
version: '3'

vars:
  ONBOARDER_VERSION: "{{ onboarder.tag }}"

includes:
  Lifecycle:
    taskfile: {{ openspace_directory }}/automation/lifecycle-manager/Taskfile.lcm.yml
  Reference:
    taskfile: {{ openspace_directory }}/automation/reference_architecture/Taskfile.ref_arch.yml
  Clusters:
    taskfile: {{ openspace_directory }}/automation/clusters/Taskfile.clusters.yml
  Onboarder:
    taskfile: {{ openspace_directory }}/automation/onboarder/Taskfile.onboarder.yml
  Servers:
    taskfile: {{ openspace_directory }}/automation/servers/Taskfile.servers.yml
  Virtualization:
    taskfile: {{ openspace_directory }}/automation/virtualization/Taskfile.virtualization.yml
  Custom:
    taskfile: {{ openspace_directory }}/env/{{ env_name }}/custom/Taskfile.yml
    optional: true