#!/bin/bash
#=============================================================================
# openspace-build - Day 0 deployment for OpenSpace Lifecycle Manager
#
# Usage: openspace-build <task> [args...]
# Example: openspace-build basekit:deploy
#          openspace-build mcm:vm:deploy
#          openspace-build --list
#=============================================================================
set -euo pipefail

if [[ ! -f "${OPENSPACE_SITE}/Taskfile.build.yml" ]]; then
  echo "ERROR: No site configured. Run 'openspace init <site-name>' first."
  exit 1
fi

if [[ $# -eq 0 ]]; then
  echo "OpenSpace Build"
  echo ""
  echo "Usage: openspace-build <task> [args...]"
  echo ""
  echo "Run 'openspace-build --list' to see available build tasks"
  exit 0
fi

cd "${OPENSPACE_SITE}"
exec task -t Taskfile.build.yml "$@"