#!/usr/bin/env bash
set -euo pipefail

OPENSPACE_ROOT="${OPENSPACE_ROOT:-/opt/openspace}"
LCM_DIR="$OPENSPACE_ROOT/automation/lifecycle-manager"
BOOT_TF="$LCM_DIR/Taskfile.lcm.yml"
TUI_PY="$LCM_DIR/openspace_tui.py"
ENV_DIR="$OPENSPACE_ROOT/env"

usage() {
  cat <<EOF
Usage:
  openspace
      Launch TUI (requires active environment)

  openspace init --deployment <file> --onboarder <onboarder.tar.gz>
      Bootstrap new environment

Options:
  --deployment <file>   Path to deployment.yml (required)
  --onboarder <file>    Path to onboarder tarball (required)
  -h, --help            Show help
EOF
}

extract_env_name() {
  grep '^env_name:' "$1" | awk '{print $2}'
}

cmd_init() {
  shift || true

  local DEPLOYMENT=""
  local ONBOARDER=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --deployment)
        DEPLOYMENT="${2:-}"
        shift 2
        ;;
      --onboarder)
        ONBOARDER="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown argument: $1"
        usage
        exit 2
        ;;
    esac
  done

  if [[ -z "$DEPLOYMENT" ]]; then
    echo "ERROR: --deployment is required"
    exit 2
  fi

  [[ "$DEPLOYMENT" != /* ]] && DEPLOYMENT="$(pwd)/$DEPLOYMENT"
  [[ ! -f "$DEPLOYMENT" ]] && { echo "Deployment file not found."; exit 2; }

  echo "Bootstrapping OpenSpace..."
  export OPENSPACE_DEPLOYMENT_FILE="$DEPLOYMENT"

  task -t "$BOOT_TF" Env:Init DEPLOYMENT_FILE="$DEPLOYMENT"

  # ----- Determine env name -----
  ENV_NAME="$(extract_env_name "$DEPLOYMENT")"

  if [[ -z "$ENV_NAME" ]]; then
    echo "ERROR: Could not determine env_name from deployment file."
    exit 1
  fi

  if [[ ! -d "$ENV_DIR/$ENV_NAME" ]]; then
    echo "ERROR: Expected environment directory not created:"
    echo "  $ENV_DIR/$ENV_NAME"
    exit 1
  fi

  echo "Environment '$ENV_NAME' created successfully."
}

cmd_tui() {
  exec python3 "$TUI_PY"
}

case "${1:-}" in
  init) cmd_init "$@";;
  -h|--help) usage;;
  "" ) cmd_tui;;
  *) echo "Unknown command: $1"; usage; exit 2;;
esac